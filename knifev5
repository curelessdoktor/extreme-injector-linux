	local function satanSacrifice()
		if working then return end
		working = true
		notify("⛧ THE OFFERING BEGINS ⛧", true)
		pcall(function()
			local hum = char:FindFirstChildOfClass('Humanoid')
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local torso = char:FindFirstChild("Torso")
			if not hum or not hrp or not torso then working = false; return end

			-- Freeze player in place for ritual
			hum.WalkSpeed = 0; hum.JumpPower = 0

			-- Build pentagram on the floor under player
			local groundY = hrp.Position.Y - 3.1
			local center = Vector3.new(hrp.Position.X, groundY, hrp.Position.Z)
			local R = 9  -- pentagram radius in studs
			local penParts = {}

			local function mkFloor(size, color, mat, cf)
				local p = Instance.new("Part", workspace)
				p.Anchored = true; p.CanCollide = false; p.CastShadow = false
				p.Size = size; p.Color = color; p.Material = mat
				p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
				p.CFrame = cf; table.insert(penParts, p); return p
			end

			-- Outer circle (flat dark disc)
			local disc = mkFloor(Vector3.new(R*2+1, 0.08, R*2+1), Color3.fromRGB(17,17,17), Enum.Material.SmoothPlastic,
				CFrame.new(center))
			Instance.new("CylinderMesh", disc)

			-- Full red circle (pentagram sits on this)
			local redCircle = mkFloor(Vector3.new(R*2, 0.075, R*2), Color3.fromRGB(196,40,28), Enum.Material.Neon,
				CFrame.new(center + Vector3.new(0,0.005,0)))
			redCircle.Transparency = 0.15
			Instance.new("CylinderMesh", redCircle)

			-- Dark red inner glow ring
			local ring = mkFloor(Vector3.new(R*2-0.5, 0.09, R*2-0.5), Color3.fromRGB(136,0,0), Enum.Material.Neon,
				CFrame.new(center + Vector3.new(0,0.01,0)))
