-- FPS counter (throttled)
local avgs, lastFpsUpdate = {}, 0
RunService.Heartbeat:Connect(function(step)
	local t = tick()
	if t - lastFpsUpdate < 0.15 then return end
	lastFpsUpdate = t
	local f = math.floor((1/step)*10)/10
	if #avgs > 60 then table.remove(avgs,1) end
	table.insert(avgs, f)
	local sum = 0
	for i = 1, #avgs do sum += avgs[i] end
	fps.Text = 'FPS: '..math.floor(sum/#avgs)
end)

