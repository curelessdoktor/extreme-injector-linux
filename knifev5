		-- Right hand blade (parented to handle, normal knife swing-out)
		makeBlade(handle, CFrame.new(0,-0.55,0)*CFrame.Angles(0,0,math.rad(90)), CFrame.new(0.5,0,0))
		-- Left hand blade (parented to Left Arm for true dual wield)
		local leftArm = char:FindFirstChild("Left Arm")
