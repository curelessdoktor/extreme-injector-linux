local function stun(char)
	pcall(function() char:FindFirstChildOfClass('Humanoid'):ChangeState(Enum.HumanoidStateType.Physics) end)
	for _, v in ipairs(rekt) do if v == char then return end end
	table.insert(rekt, char)
end

local function unstun(char)
	for i, v in ipairs(rekt) do
		if v == char then
			local hum = v:FindFirstChildOfClass('Humanoid')
			if hum and hum.Health > 0 then
				hum:ChangeState(Enum.HumanoidStateType.Running)
				hum.PlatformStand = false
				hum.Sit = false
				hum.Jump = true
				hum.JumpPower = 50
				hum.WalkSpeed = 16
				hum.Name = "Humanoid"
			end
			table.remove(rekt, i)
			return
		end
	end
end


local function recurse(root, callback)
	for _, v in ipairs(root:GetChildren()) do
		callback(v)
		if #v:GetChildren() > 0 then recurse(v, callback) end
	end
end

local function getAttachment0(char, name)
	for _, child in ipairs(char:GetChildren()) do
		local att = child:FindFirstChild(name)
		if att then return att end
	end
end

local function makeHinge(parent, a0, a1)
	local c = Instance.new("HingeConstraint")
	c.Attachment0 = a0; c.Attachment1 = a1
	c.LimitsEnabled = true; c.UpperAngle = 0; c.LowerAngle = 0
	c.Parent = parent
end

local function addCollider(char, part, sizeDivisor, offY)
	if not (char:FindFirstChildOfClass('Humanoid') and char:FindFirstChildOfClass('Humanoid').Health > 0) then return end
	local col = Instance.new('Part', part)
	col.Size = part.Size / (sizeDivisor or 2)
	col.CanCollide = true; col.Name = "Collision"
	col.Anchored = false; col.Transparency = 1
	col.CFrame = part.CFrame
	col:BreakJoints()
	local a0 = Instance.new('Attachment', part)
	local a1 = Instance.new('Attachment', col)
	if offY then a0.Position = Vector3.new(0, offY, 0) end
	makeHinge(char, a0, a1)
end

local function ragdollJoint(char, part0, part1, attName, class, props)
	if char:FindFirstChild("RagdollConstraint"..part1.Name) then return end
	local hrp = char:FindFirstChild('HumanoidRootPart')
	if hrp then hrp.CanCollide = false end
	for _, v in ipairs(char:GetChildren()) do
		if v:IsA("MeshPart") and (
			v.MeshId:find('553602991') or v.MeshId:find('553602977') or v.MeshId:find('553602987')
			) then v.Size = Vector3.new(1,1,1) end
	end
	recurse(char, function(v)
		if v:IsA("Attachment") and v.Parent.Name ~= "ayybleed" then
			v.Axis = Vector3.new(0,1,0)
			v.SecondaryAxis = Vector3.new(0,0,1)
			v.Rotation = Vector3.new(0,0,0)
		end
	end)
	local motor = part1:FindFirstChildOfClass('Motor6D')
	if motor then motor:Destroy() end
	if attName ~= "NeckAttachment" then attName = attName.."RigAttachment" end
	local constraint = Instance.new(class.."Constraint")
	constraint.Attachment0 = part0:FindFirstChild(attName)
	constraint.Attachment1 = part1:FindFirstChild(attName)
	constraint.Name = "RagdollConstraint"..part1.Name
	for _, p in ipairs(props or {}) do constraint[p[1]] = p[2] end
	constraint.Parent = char
	-- Collider sizing
	local div = 2
	if part1.Name:lower():find("upper") then
		div = part1.Name:lower():find("leg") and 3 or 2.5
	end
	local offY = 0
	if part1.Name:lower():find("upper") then
		offY = part1.Name:lower():find("leg") and 0.01 or 0.25
	else offY = -0.1 end
	addCollider(char, part1, div, offY)
end

local function R6ragdollJoint(char, limbname, attached, heded)
	pcall(function()
		local torso = char:FindFirstChild("Torso")
		if not torso or not char:FindFirstChild(limbname) then return end
		local data = {
			["Right Arm"] = {torsoPos=Vector3.new(1.45,0.768,-0.009), joint="Right Shoulder"},
			["Left Arm"]  = {torsoPos=Vector3.new(-1.45,0.768,-0.009), joint="Left Shoulder"},
			["Right Leg"] = {torsoPos=Vector3.new(0.45,-1.242,-0.009), joint="Right Hip", stun=true},
			["Left Leg"]  = {torsoPos=Vector3.new(-0.45,-1.242,-0.009), joint="Left Hip", stun=true},
		}
		local d = data[limbname]
		if not d then return end
		if d.stun then stun(char) end
		if torso:FindFirstChild(limbname.."RagdollConstraint") then return end
		local ta = Instance.new('Attachment', torso)
		ta.Name = limbname.."RagdollConstraint"
		ta.Position = d.torsoPos
		ta.Axis = Vector3.new(1,0,0); ta.SecondaryAxis = Vector3.new(0,1,0)
		local la = Instance.new('Attachment', char[limbname])
		la.Position = Vector3.new(-0.086,0.755,-0.007)
		la.Name = limbname.."RagdollConstraint"
		la.Axis = Vector3.new(1,0,0); la.SecondaryAxis = Vector3.new(0,1,0)
		local ball = Instance.new('BallSocketConstraint', char)
		ball.Attachment0 = ta; ball.Attachment1 = la
		addCollider(char, char[limbname], 1.5)
		if torso:FindFirstChild(d.joint) then torso[d.joint]:Destroy() end
	end)
end

local function doHeadRagdoll(char, attached, heded)
	local hum = char:FindFirstChildOfClass('Humanoid')
	if hum then hum.Health = 0 end
	while char:FindFirstChildOfClass('Humanoid') and char:FindFirstChildOfClass('Humanoid').Health > 0 do task.wait() end
	local hrp = char:FindFirstChild('HumanoidRootPart')
	if hrp then hrp:Destroy() end
	Debris:AddItem(char, 10)
	-- Ragdoll accessories
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("Accoutrement") then
			for _, part in ipairs(child:GetChildren()) do
				if part:IsA("BasePart") then
					for _, c in ipairs(part:GetChildren()) do if c:IsA('Weld') then c:Destroy() end end
					local a1 = part:FindFirstChildOfClass("Attachment")
					local a0 = a1 and getAttachment0(char, a1.Name)
					if a0 and a1 then makeHinge(char, a0, a1) end
				end
			end
		end
	end
	for _, v in ipairs(char:GetChildren()) do
		if v:IsA('MeshPart') or v:IsA('BasePart') then
			for _, c in ipairs(v:GetChildren()) do
				if c.Name == "Collision" then c:Destroy() end
			end
		end
	end
end

function ragdollpart(character, partname, attached, heded)
	-- Head neck spine setup
	if heded ~= false then
		pcall(function()
			local neck = Instance.new('Attachment', character.Head)
			neck.Name = "NeckAttachment"; neck.Position = Vector3.new(0,-0.5,0)
		end)
	else
		applyForce(character.Head, Vector3.new(0, 500, 0), 0.25)
		pcall(function()
			-- Spine rope
			local asdf = Instance.new('Attachment', character.Head)
			asdf.Position = Vector3.new(0, -character.Head.Size.Y/2, 0)
			local last = asdf
			for i = 1, 14 do
				local bone = Instance.new('Part', character)
				bone.Color = Color3.fromRGB(248,248,248)
				bone.Size = Vector3.new(0.1,0.1,0.1)
				bone.CFrame = character.Head.CFrame + (character.Head.CFrame.upVector * -(i/10))
				local latt = Instance.new('Attachment', bone)
				local rope = Instance.new('RopeConstraint', bone)
				rope.Attachment0 = latt; rope.Attachment1 = last
				rope.Visible = true; rope.Thickness = 0.05
				rope.Color = Color3.fromRGB(196,40,28); rope.Length = 0.2
				last = latt
			end
			-- Head bleed part
			local bleedee = Instance.new('Part', character.Head)
			bleedee.Size = Vector3.new(0.75,0.25,0.75)
			bleedee.CanCollide = false; bleedee.Color = ColorPreview.BackgroundColor3
			bleedee.CFrame = character.Head.CFrame
			Instance.new('CylinderMesh', bleedee)
			bleedee:BreakJoints()
			local a1 = Instance.new('Attachment', bleedee)
			a1.Position = Vector3.new(0, character.Head.Size.Y/2, 0); a1.Orientation = Vector3.new(0,0,180)
			local a0 = Instance.new('Attachment', character.Head)
			makeHinge(character, a0, a1)
			task.spawn(function() bleed(bleedee) end)
		end)
		-- Torso bleed
		local thang = character:FindFirstChild('UpperTorso') and "UpperTorso" or "Torso"
		pcall(function()
			local bleedee = Instance.new('Part', character[thang])
			bleedee.Size = Vector3.new(0.75,0,0.75); bleedee.CanCollide = false
			bleedee.Color = ColorPreview.BackgroundColor3; bleedee.CFrame = character[thang].CFrame
			Instance.new('CylinderMesh', bleedee); bleedee:BreakJoints()
			local a1 = Instance.new('Attachment', bleedee)
			a1.Position = Vector3.new(0, -character[thang].Size.Y/2, 0); a1.Orientation = Vector3.new(0,0,180)
			local a0 = Instance.new('Attachment', character[thang])
			makeHinge(character, a0, a1)
			task.spawn(function() bleed(bleedee) end)
		end)
	end

	if partname == "HumanoidRootPart" then
		partname = character:FindFirstChild('Torso') and "Torso" or "UpperTorso"
	end
	-- Detach/bisect
	if attached == false then
		if character:FindFirstChild('UpperTorso') then
			pcall(function() character.UpperTorso.WaistRigAttachment:Destroy() end)
			-- Upper and lower bleed attachment parts
			for _, tname in ipairs({"UpperTorso","LowerTorso","Right Leg","Left Leg"}) do
				pcall(function()
					local part = character[tname]
					local ab = Instance.new('Part', character)
					ab.Size = Vector3.new(part.Size.X-0.1, 0.1, part.Size.Z-0.1)
					ab.Transparency = 1; ab.CanCollide = false
					ab.CFrame = part.CFrame; ab:BreakJoints(); ab.Name = "ayybleed"
					local a1 = Instance.new('Attachment', ab)
					a1.Position = Vector3.new(0, -part.Size.Y/2, 0); a1.Orientation = Vector3.new(0,0,0)
					local a0 = Instance.new('Attachment', part)
					makeHinge(character, a0, a1)
					task.spawn(function() bleed(ab) end)
				end)
			end
			-- Visible blood cap
			for _, tname in ipairs({"UpperTorso","LowerTorso"}) do
				pcall(function()
					local part = character[tname]
					local ab = Instance.new('Part', character)
					ab.Size = Vector3.new(part.Size.X-0.1, 0.1, part.Size.Z-0.1)
					ab.Color = ColorPreview.BackgroundColor3; ab.Material = Enum.Material.SmoothPlastic
					ab.Name = "ayybleed"; ab.CanCollide = false; ab.Transparency = 0
					ab.CFrame = part.CFrame; ab:BreakJoints()
					local sign = tname == "UpperTorso" and 1 or -1
					local a1 = Instance.new('Attachment', ab)
					a1.Position = Vector3.new(0, sign*(part.Size.Y/2 - 0.045), 0)
					local a0 = Instance.new('Attachment', part)
					makeHinge(character, a0, a1)
				end)
			end
		end
		partname = "Head"
	end
	-- R15 part routing
	local R15routes = {
		RightHand=true, RightLowerArm=true, RightUpperArm=true,
		LeftHand=true, LeftLowerArm=true, LeftUpperArm=true,
		RightFoot=true, RightUpperLeg=true, RightLowerLeg=true,
		LeftFoot=true, LeftUpperLeg=true, LeftLowerLeg=true,
		Head=true, UpperTorso=true, LowerTorso=true
	}
	local hum = character:FindFirstChildOfClass('Humanoid')
	if R15routes[partname] and hum and hum.RigType == Enum.HumanoidRigType.R15 then
		if partname == "Head" or partname == "UpperTorso" or partname == "LowerTorso" then
			doHeadRagdoll(character, attached, heded)
			if heded == false then
				pcall(function()
					character.Head.Neck:Destroy()
					character.Head.NeckRigAttachment:Destroy()
					character.UpperTorso:FindFirstChild('NeckAttachment'):Destroy()
				end)
			end
			ragdollJoint(character, character.LowerTorso, character.UpperTorso, "Waist", "BallSocket",
				{{"LimitsEnabled",true},{"UpperAngle",5},{"Radius",5}})
			ragdollJoint(character, character.UpperTorso, character.Head, "Neck", "Hinge",
				{{"LimitsEnabled",true},{"UpperAngle",50},{"LowerAngle",-50}})
			-- All limbs
			if character:FindFirstChild('LeftLowerArm') and character:FindFirstChild('LeftHand') then
				ragdollJoint(character, character.LeftLowerArm, character.LeftHand, "LeftWrist", "Hinge", JOINT_PROPS.hand)
			end
			if character:FindFirstChild('RightLowerArm') and character:FindFirstChild('RightHand') then
				ragdollJoint(character, character.RightLowerArm, character.RightHand, "RightWrist", "Hinge", JOINT_PROPS.hand)
			end
			for _, side in ipairs({"Left","Right"}) do
				local up, lo, ft = side.."UpperLeg", side.."LowerLeg", side.."Foot"
				local ua, la = side.."UpperArm", side.."LowerArm"
				if character:FindFirstChild(up) and character:FindFirstChild(lo) then
					ragdollJoint(character, character[up], character[lo], side.."Knee", "Hinge", JOINT_PROPS.shin)
				end
				if character:FindFirstChild(lo) and character:FindFirstChild(ft) then
					ragdollJoint(character, character[lo], character[ft], side.."Ankle", "Hinge", JOINT_PROPS.foot)
				end
				if character:FindFirstChild('UpperTorso') and character:FindFirstChild(ua) then
					ragdollJoint(character, character.UpperTorso, character[ua], side.."Shoulder", "BallSocket")
				end
				if character:FindFirstChild(ua) and character:FindFirstChild(la) then
					ragdollJoint(character, character[ua], character[la], side.."Elbow", "BallSocket")
				end
				if character:FindFirstChild('LowerTorso') and character:FindFirstChild(up) then
					ragdollJoint(character, character.LowerTorso, character[up], side.."Hip", "BallSocket")
				end
			end
			local hrp2 = character:FindFirstChild('HumanoidRootPart')
			if hrp2 then hrp2:Destroy() end
		elseif partname:find("Right") or partname:find("Left") then
			local side = partname:find("Right") and "Right" or "Left"
			if partname:find("Arm") or partname:find("Hand") then
				ragdollJoint(character, character[side.."LowerArm"], character[side.."Hand"], side.."Wrist", "Hinge", JOINT_PROPS.hand)
				ragdollJoint(character, character.UpperTorso, character[side.."UpperArm"], side.."Shoulder", "BallSocket")
				ragdollJoint(character, character[side.."UpperArm"], character[side.."LowerArm"], side.."Elbow", "BallSocket")
			else
				stun(character)
				ragdollJoint(character, character[side.."UpperLeg"], character[side.."LowerLeg"], side.."Knee", "Hinge", JOINT_PROPS.shin)
				ragdollJoint(character, character[side.."LowerLeg"], character[side.."Foot"], side.."Ankle", "Hinge", JOINT_PROPS.foot)
				ragdollJoint(character, character.LowerTorso, character[side.."UpperLeg"], side.."Hip", "BallSocket")
			end
		end
	else
		R6ragdollJoint(character, partname, attached, heded)
	end
end


local function lerp(weld, startpos, endpos, t, longatend)
	for i = 1, t*100 do
		if longatend then startpos = weld.C0 end
		weld.C0 = startpos:Lerp(endpos, i/(t*100))
		task.wait(0.01)
	end
end

local function grow(weld, part, endSize, endPos, t)
	local startC1, startSize = weld.C1, part.Size
	local parent = weld.Parent
	local pe = Instance.new("ParticleEmitter")
	pe.LightEmission = 3
	pe.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(42,0,255)),
		ColorSequenceKeypoint.new(0.1, Color3.fromRGB(248,153,0)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255,255,0))
	})
	pe.LightInfluence = 0.75
	pe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0,1), NumberSequenceKeypoint.new(1,0)})
	pe.Lifetime = NumberRange.new(0.1,1)
	pe.Rate = 50; pe.RotSpeed = NumberRange.new(300); pe.Speed = NumberRange.new(0,1)
	pe.SpreadAngle = Vector2.new(90,90); pe.Parent = part
	for i = 1, t*100 do
		weld.C1 = startC1:Lerp(endPos, i/(t*100))
		part.Size = startSize:Lerp(endSize, i/(t*100))
		weld.Parent = parent
		task.wait(0.01)
	end
	pe.Enabled = false
end

-- Helper: restore R6 joint
local function restoreJoint(char, jointName, part0Name, part1Name)
	local template = JOINT_TEMPLATES[jointName]
	if not template then return end
	pcall(function()
		if not (char:FindFirstChild(part0Name) and char:FindFirstChild(part1Name)) then return end
		local clone = Instance.new('Motor6D')
		clone.Name = jointName
		for k, v in pairs(template) do clone[k] = v end
		clone.Part0 = char[part0Name]
		clone.Part1 = char[part1Name]
		clone.Parent = char[part0Name]
	end)
end

-- Helper: make weld
local function makeWeld(parent, p0, p1, c0)
	local w = Instance.new('Weld', parent)
	w.Part0 = p0; w.Part1 = p1
	if c0 then w.C0 = c0 end
	return w
end

