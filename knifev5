local function bleed(frick, white)
	while frick.Parent and frick.Parent.Parent do
		task.spawn(function()
			local drop = Instance.new('Part', workspace)
			drop.Size = Vector3.new(0.2,0.2,0.2)
			drop.CFrame = frick.CFrame
			drop.Transparency = 1
			drop.Color = white and Color3.new(1,1,1) or ColorPreview.BackgroundColor3
			drop.Material = Enum.Material.SmoothPlastic
			drop.Name = "Blood"
			drop.CanCollide = false
			drop:BreakJoints()
			applyForce(drop, frick.CFrame.upVector * (math.random()*2) + Vector3.new(math.random(-5,5)/10, 1.5, 0), 0.01)
			local pe = Instance.new('ParticleEmitter', drop)
			local col = white and Color3.new(1,1,1) or ColorPreview.BackgroundColor3
			pe.Color = ColorSequence.new(col, col)
			pe.Size = NumberSequence.new(0.1)
