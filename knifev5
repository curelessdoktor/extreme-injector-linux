			local lb = Instance.new("Part"); lb.Name = "blade"; lb.Parent = handle
			for _, s in ipairs({"Top","Bottom","Left","Right","Front","Back"}) do lb[s.."Surface"] = Enum.SurfaceType.SmoothNoOutlines end
