				m.Part0 = char.Torso; m.Part1 = char["Right Leg"]; m.Parent = char.Torso
			end)
		end
	end

	-- Clear blade/weapon parts with particle effect
	local function getrid()
		if grabbed then release() end
		blademode = "handle"
		for _, ree in ipairs(handle:GetChildren()) do
			if ree:IsA('BasePart') then
				local part = Instance.new('Part', workspace)
				part.CFrame = ree.CFrame; part.Anchored = true
				part.CanCollide = false; part.Size = ree.Size; part.Transparency = 1
				ree:Destroy()
				local pe = Instance.new("ParticleEmitter", part)
				pe.Acceleration = Vector3.new(0,1,0)
				pe.Lifetime = NumberRange.new(0.1,0.2)
				pe.Speed = NumberRange.new(0.5); pe.Rate = 20000
				pe.RotSpeed = NumberRange.new(-30,30); pe.Rotation = NumberRange.new(0,360)
				pe.Size = NumberSequence.new(part.Size.X*2)
				pe.Texture = "rbxassetid://244221440"
				pe.Transparency = NumberSequence.new(0.9)
				pe.ZOffset = 5; pe.VelocitySpread = 360; pe.Enabled = true
				task.delay(0.2, function() pe.Enabled = false; Debris:AddItem(part,0.5) end)
			else ree:Remove() end
		end
	end

