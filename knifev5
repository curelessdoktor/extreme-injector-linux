			local lbw = makeWeld(lb,lb,leftArm); lbw.C0 = CFrame.new(0,1.1,0)*CFrame.Angles(0,0,math.rad(90))
			task.spawn(function() grow(lbw,lb,Vector3.new(0.22,1.2,0.1),CFrame.new(0,1.1,0)*CFrame.Angles(0,0,math.rad(90)),0.09) end)
			local le = Instance.new("Part"); le.Name = "blade"; le.Parent = handle
			for _, s in ipairs({"Top","Bottom","Left","Right","Front","Back"}) do le[s.."Surface"] = Enum.SurfaceType.SmoothNoOutlines end
			le.Material = Enum.Material.Metal; le.Color = Color3.fromRGB(236,218,190)
			le.Size = Vector3.new(0.1,0.1,0.05); le.Anchored = false; le:BreakJoints()
			local lew = makeWeld(le,le,lb); lew.C0 = CFrame.new(0.08,0,0)
			task.spawn(function() grow(lew,le,Vector3.new(0.1,1.2,0.05),CFrame.new(0.08,0,0),0.09) end)
			-- Left blade hit detection
			lb.Touched:Connect(function(hit)
				if not hit.Parent then return end
				if (blademode == "dualblade") and swinging then
					local hum = hit.Parent:FindFirstChildOfClass('Humanoid')
					if hum and hum.Health > 0 and hit.Parent ~= char then
						playStabSound(char.Torso)
						swinging = false
						local isLethal = (hit.Name == "Head" or hit.Name == "Torso" or hit.Name == "UpperTorso" or hit.Name == "LowerTorso")
						if isLethal then
							pcall(function() hit.Parent.HumanoidRootPart:Destroy() end)
							ragdollAllLimbs(hit.Parent)
							addKill(hit.Position)
						else
							pcall(function() ragdollpart(hit.Parent, hit.Name) end)
						end
						pcall(function()
							local ab = Instance.new('Part',hit.Parent)
							ab.Size = Vector3.new(0.2,0.2,0.2); ab.Color = Color3.fromRGB(136,0,0)
							ab.Material = Enum.Material.SmoothPlastic; ab.Name = "ayybleed"
							ab.CanCollide = false; ab.Transparency = 1; ab.CFrame = hit.CFrame; ab:BreakJoints()
							Debris:AddItem(ab,8); task.spawn(function() bleed(ab) end)
						end)
					end
				end
			end)
		end
	end


	local function dodgeRoll()
		if working then return end
		working = true
		pcall(function()
			local hum = char:FindFirstChildOfClass('Humanoid')
			if not hum or hum.Health <= 0 then working = false return end
			local tweld = makeWeld(char.HumanoidRootPart, char.HumanoidRootPart, char.Torso)
			local rweld = makeWeld(char["Right Arm"], char.Torso, char["Right Arm"], CFrame.new(1.5,0,0))
			local lweld = makeWeld(char["Left Arm"], char.Torso, char["Left Arm"], CFrame.new(-1.5,0,0))
			-- Tuck arms in
			task.spawn(function() lerp(rweld,rweld.C0,CFrame.new(1,0,-0.5)*CFrame.Angles(math.rad(60),0,math.rad(-30)),0.06) end)
			lerp(lweld,lweld.C0,CFrame.new(-1,0,-0.5)*CFrame.Angles(math.rad(60),0,math.rad(30)),0.06)
			-- Apply forward roll velocity (horizontal only so gravity still acts on Y)
			local rollDir = char.HumanoidRootPart.CFrame.lookVector
			applyVelocity(char.HumanoidRootPart, Vector3.new(rollDir.X, 0, rollDir.Z).Unit * 55, 0.25)
			-- Spin torso
			for i = 1, 8 do
				tweld.C0 = CFrame.Angles(math.rad(i*45),0,0)
				task.wait(0.03)
			end
			task.spawn(function() lerp(rweld,rweld.C0,CFrame.new(1.5,0,0),0.08) end)
			lerp(lweld,lweld.C0,CFrame.new(-1.5,0,0),0.08)
			rweld:Destroy(); lweld:Destroy(); tweld:Destroy()
			restoreArms(char)
		end)
		working = false
	end

