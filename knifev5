			-- Connect every other vertex: 0→2, 1→3, 2→4, 3→0, 4→1
			local connections = {{1,3},{2,4},{3,5},{4,1},{5,2}}
			for _, c in ipairs(connections) do
				local a, b = verts[c[1]], verts[c[2]]
				local mid = (a + b) / 2
				local len = (b - a).Magnitude
				local ang2 = math.atan2(b.Z - a.Z, b.X - a.X)
				local line = mkFloor(Vector3.new(len, 0.1, 0.22), Color3.fromRGB(196,40,28), Enum.Material.Neon,
					CFrame.new(mid) * CFrame.Angles(0, -ang2, 0))
				line.Transparency = 0.1
