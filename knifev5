			local innerDisc = mkFloor(Vector3.new(R*2-2, 0.1, R*2-2), Color3.fromRGB(17,17,17), Enum.Material.SmoothPlastic,
				CFrame.new(center + Vector3.new(0,0.02,0)))
			Instance.new("CylinderMesh", innerDisc)

			-- 5 pentagram line segments
			-- Vertices of pentagram: angles 90, 162, 234, 306, 18 degrees
			local verts = {}
			for i = 0, 4 do
				local ang = math.rad(90 + i*72)
				table.insert(verts, Vector3.new(
					center.X + R * math.cos(ang),
					groundY + 0.06,
					center.Z - R * math.sin(ang)
