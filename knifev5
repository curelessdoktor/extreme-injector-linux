			lerp(lweld, lweld.C0, CFrame.new(-1.9,0.1,0)*CFrame.Angles(0,0,math.rad(95)), 0.07)

			-- Ritual chant sound
			local chant = Instance.new("Sound", torso)
			chant.SoundId = "rbxassetid://1602211288"; chant.Volume = 5; chant.Looped = true; chant:Play()

			-- Set self on fire
