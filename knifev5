	local function equip()
		equipped = true; working = true
		local rs = char.Torso:FindFirstChild("Right Shoulder")
		if rs then rs:Destroy() end
		local weld = makeWeld(char.Torso, char["Right Arm"], char.Torso, CFrame.new(-1.5,0,0))
