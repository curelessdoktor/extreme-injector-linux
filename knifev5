local mousedown, slidee = false, false
mouse.Button1Down:Connect(function() mousedown = true end)
mouse.Button1Up:Connect(function() mousedown = false; slidee = false end)
Slidee.MouseButton1Down:Connect(function() slidee = true end)
Slidee.MouseButton1Up:Connect(function() slidee = false end)

mouse.Move:Connect(function()
	if mousedown then
		local imgPos = ImageLabel.AbsolutePosition
		local imgSize = ImageLabel.AbsoluteSize
		if mouse.X >= imgPos.X and mouse.X <= imgPos.X + imgSize.X and
			mouse.Y >= imgPos.Y and mouse.Y <= imgPos.Y + imgSize.Y then
			local nx = (imgSize.X - (mouse.X - imgPos.X)) / imgSize.X
			local ny = (imgSize.Y - (mouse.Y - imgPos.Y)) / imgSize.Y
			local newColor = Color3.fromHSV(nx, ny, BrightnessOverlay.BackgroundTransparency)
			updateBloodLabel(newColor)
		end
	end
	if slidee then
		local x = math.clamp(mouse.X, Slider.AbsolutePosition.X, Slider.AbsolutePosition.X + Slider.AbsoluteSize.X)
		Slidee.Position = UDim2.new(0, x - Slider.AbsolutePosition.X, 0, 0)
		BrightnessOverlay.BackgroundTransparency = 1 - (Slidee.Position.X.Offset / Slider.AbsoluteSize.X)
	end
end)

local function rgbBoxHandler(box, channel)
	box.FocusLost:Connect(function()
		local val = tonumber(box.Text)
		if val then
			val = math.clamp(val, 0, 255) / 255
			local c = ColorPreview.BackgroundColor3
			local newColor
			if channel == "r" then newColor = Color3.new(val, c.g, c.b)
			elseif channel == "g" then newColor = Color3.new(c.r, val, c.b)
			else newColor = Color3.new(c.r, c.g, val) end
			updateBloodLabel(newColor)
		end
		box.Text = "Input"
	end)
end
