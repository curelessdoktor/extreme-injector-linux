	local function oogabooga()
		if rdd == false then
			rdd = true
			ragdollAllLimbs(char)
			unstun(char)
			for _, v in ipairs(char:GetChildren()) do
				v.ChildAdded:Connect(function(child)
					if rdd and child.Name ~= "Neck" and child.Name ~= "RootJoint" and child.Name ~= "Root"
						and (child:IsA('Motor6D') or child:IsA('Weld')) and child ~= grabweld then
						task.defer(function() child:Destroy() end)
					end
				end)
				if v.Name:lower():find('leg') then
					local col = v:FindFirstChild('Collision')
					if col then col:Destroy() end
				end
			end
		else
			rdd = false
			for _, v in ipairs(char:GetChildren()) do
				if v:IsA('HingeConstraint') or v:IsA('BallSocketConstraint') then v:Destroy()
				elseif v:IsA('BasePart') then
					local col = v:FindFirstChild('Collision')
					if col then col:Destroy() end
					for _, c in ipairs(v:GetChildren()) do
						if c.Name:lower():find("ragdoll") then c:Destroy() end
					end
				end
			end
			restoreArms(char)
			pcall(function()
				local t = JOINT_TEMPLATES.LeftShoulder
				local m = Instance.new('Motor6D'); m.Name = "Left Hip"
				m.C0 = JOINT_TEMPLATES.LeftHip.C0; m.C1 = JOINT_TEMPLATES.LeftHip.C1
