local NOTIFY_DISPLAY_TIME = 5.5

function notify(msg, persist)
	task.spawn(function()
		for _, v in ipairs(MainGUI:GetChildren()) do
			if v:IsA('TextLabel') and v.Name == "Notification" then v:Destroy() end
		end
		if not msg then return end
		local lbl = makeGui("TextLabel", {
			Name = "Notification", Parent = MainGUI, BackgroundColor3 = Color3.fromRGB(12,0,0),
			BorderSizePixel = 0, Position = UDim2.new(0.25,0,0.05,-10),
			Size = UDim2.new(0.5,0,0.1,0), Font = Enum.Font.GothamBold,
			TextColor3 = Color3.fromRGB(220,30,30), TextScaled = true, Transparency = 1,
			Text = "", TextYAlignment = Enum.TextYAlignment.Top, TextXAlignment = Enum.TextXAlignment.Left
		})
		local bar = makeGui("Frame", {
			Parent = lbl, BackgroundColor3 = Color3.fromRGB(180,0,0),
			BorderSizePixel = 0, Transparency = 1, Position = UDim2.new(0,0,1,0),
			Size = UDim2.new(1,0,0,5)
		})
		local step = 0.03
		for i = 1, 10 do
			lbl.Transparency = lbl.Transparency - 0.1
			lbl.Position = lbl.Position + UDim2.new(0,0,0,1)
			bar.Transparency = bar.Transparency - 0.1
			task.wait(step)
		end
		for i = 1, #msg do lbl.Text = string.sub(msg,1,i); task.wait(0.018) end
		task.wait(NOTIFY_DISPLAY_TIME)
		if not persist then
			for i = 1, 10 do
				lbl.Transparency = lbl.Transparency + 0.1
				lbl.Position = lbl.Position - UDim2.new(0,0,0,1)
				bar.Transparency = bar.Transparency + 0.1
				task.wait(step)
			end
			lbl:Destroy()
		end
	end)
end

