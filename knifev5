	local function whoosh(vroom)
		vroom.Parent = workspace; vroom.Name = "Projectile"
		vroom.CFrame = CFrame.new(char.Head.CFrame.p, mouse.Hit.p)*CFrame.Angles(0,math.rad(90),0)
		vroom.Anchored = false; vroom.Velocity = Vector3.new(0,0,0); vroom.RotVelocity = Vector3.new(0,0,0)
		Debris:AddItem(vroom, 10)
		applyVelocity(vroom, vroom.CFrame.rightVector * 200, 10)
		local touched = false
		for _, v in ipairs(vroom:GetChildren()) do
			if v:IsA('BasePart') then
				v.Touched:Connect(function(hit)
					if touched then return end
					if hit and hit.Parent and hit.Transparency ~= 1 and hit.Parent ~= char then
						local hasHum = hit.Parent:FindFirstChildOfClass('Humanoid')
						if hasHum and hasHum.Health > 0 or (hit.CanCollide and not hasHum) then
							touched = true
							local before = hit.Anchored
							vroom.Anchored = true; vroom.Velocity = Vector3.new(0,0,0); vroom.RotVelocity = Vector3.new(0,0,0)
							hit.Anchored = true; flyy:Destroy()
							vroom.CFrame = vroom.CFrame - vroom.CFrame.rightVector
							pcall(function()
								local w = makeWeld(hit, hit, vroom); w.C0 = hit.CFrame:ToObjectSpace(vroom.CFrame)
							end)
							if hasHum and hasHum.Health > 0 then
								-- Bleed attachment
								pcall(function()
									local ab = Instance.new('Part', hit); ab.Size = Vector3.new(0.2,0.2,0.2)
									ab.Color = Color3.fromRGB(136,0,0); ab.Material = Enum.Material.SmoothPlastic
									ab.Name = "ayybleed"; ab.CanCollide = false; ab.Transparency = 1
									ab.CFrame = hit.CFrame; ab:BreakJoints()
									local a1 = Instance.new('Attachment', ab)
									local a0 = Instance.new('Attachment', hit)
									-- Find blade for orientation
									for _, bv in ipairs(vroom:GetChildren()) do
										if bv.Name == "blade" and bv.Size == Vector3.new(0.23,1.19,0.1) then
											bv.Name = "REEEE"
										end
									end
									if vroom:FindFirstChild("REEEE") then
										a1.Orientation = vroom.REEEE.Orientation + Vector3.new(90,0,0)
										a0.Position = hit.CFrame:ToObjectSpace(vroom.REEEE.CFrame).p - hit.CFrame:ToObjectSpace(vroom.REEEE.CFrame).upVector
									end
									makeHinge(a0, a0, a1)
									task.spawn(function() bleed(ab) end)
									if hit.Name ~= "Head" and hit.Name ~= "UpperTorso" and hit.Name ~= "Torso" and hit.Name ~= "LowerTorso" then
										Debris:AddItem(ab, 7.5)
									end
								end)
								-- Kill if torso/head hit
								if hit.Name == "Head" or hit.Name == "UpperTorso" or hit.Name == "Torso" or hit.Name == "LowerTorso" then
									pcall(function() hit.Parent.HumanoidRootPart:Destroy() end)
									ragdollAllLimbs(hit.Parent)
									addKill(hit.Position)
									task.delay(5, function() pcall(function() ragdollpart(hit.Parent,"Head") end) end)
								else
									pcall(function() ragdollpart(hit.Parent, hit.Name) end)
								end
							end
							pcall(function() vroom:FindFirstChildOfClass('Trail'):Destroy() end)
							for _, bv in ipairs(vroom:GetChildren()) do
								if bv:IsA('BasePart') then bv.CanCollide = true end
							end
							hit.Anchored = before; vroom.Anchored = false; vroom.CanCollide = true
						end
					end
				end)
			end
		end
	end

